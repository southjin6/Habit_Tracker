<Window x:Class="HabitTracker.App.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="520" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Only the text field and the toggle button are retemplated; the dropdown calendar is
             built by DatePicker itself and picks up CalendarStyle below. -->
        <Style x:Key="DarkDatePickerText" TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border CornerRadius="4" Background="{StaticResource InputBgBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="PART_Watermark" Text="Select a date"
                                           Foreground="{StaticResource PlaceholderBrush}"
                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Hidden" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="6,5" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource DarkDatePickerText}"
                                               VerticalContentAlignment="Center" />
                            <Button x:Name="PART_Button" Grid.Column="1" Margin="4,0,0,0" Width="30" Focusable="False"
                                    Style="{StaticResource GhostIconButton}" ToolTip="Show the calendar">
                                <Path Data="M1.5,3.5 H14.5 V13.5 H1.5 Z M1.5,6.5 H14.5 M4.5,1.5 V4.5 M11.5,1.5 V4.5"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.4"
                                      Fill="Transparent" StrokeLineJoin="Round" />
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}" StaysOpen="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding CreatedOnText}" FontSize="11"
                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

        <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,12">
            <StackPanel>
                <TextBlock Text="Record a completion for a past day" FontWeight="SemiBold" />
                <TextBlock Text="Filling a gap repairs a broken streak, because the streak is always recomputed from history."
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,8" />
                <DatePicker Style="{StaticResource DarkDatePicker}"
                            SelectedDate="{Binding SelectedDate}"
                            DisplayDateStart="{Binding MinimumDate, Mode=OneWay}"
                            DisplayDateEnd="{Binding MaximumDate, Mode=OneWay}" />
                <Button Content="Record completion" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource PillButton}" Command="{Binding RecordCommand}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Recorded days" FontWeight="SemiBold" Margin="2,0,0,6" />

        <ListBox Grid.Row="3" ItemsSource="{Binding Entries}" Style="{StaticResource DarkListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding StringFormat={}{0:yyyy-MM-dd}}" />
                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource PillButton}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Removing this day recomputes the streak back down" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="2,10,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
    </Grid>
</Window>
